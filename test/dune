(test
 (name test)
 (modules test testAssembly testRelkeys testSecurity testUtils)
 (preprocess (pps lwt_ppx))
 (deps ../sinks.json)
 (libraries alcotest alcotest-lwt elykseer elykseer_base elykseer_utils elykseer_crypto mlcpp_cstdio mlcpp_chrono unix yojson)
)
; command line tests of the lxr_* tools (exit codes, no partial restores)
(rule
 (alias runtest)
 (deps
  test_cli.sh
  %{exe:../bin/lxr_backup.exe}
  %{exe:../bin/lxr_restore.exe}
  %{exe:../bin/lxr_relfiles.exe}
  %{exe:../bin/lxr_distribute.exe})
 (action (run bash %{dep:test_cli.sh} ../bin)))
